{
  "id": "evolink",
  "version": 1,
  "displayName": "EvoLink",
  "adapterKind": "openai-compatible",
  "authKinds": [
    "bearer"
  ],
  "endpointKinds": [
    "static"
  ],
  "defaultHeaders": {
    "Content-Type": "application/json"
  },
  "defaultBody": {},
  "requestSchema": [
    {
      "key": "apiKey",
      "type": "string",
      "label": "API Key",
      "description": "EvoLink API key.",
      "required": true,
      "secret": true,
      "mapsTo": {
        "target": "auth",
        "path": "apiKey"
      }
    },
    {
      "key": "modelId",
      "type": "string",
      "label": "Model ID",
      "description": "EvoLink model identifier.",
      "required": true,
      "mapsTo": {
        "target": "body",
        "path": "model"
      }
    },
    {
      "key": "temperature",
      "type": "number",
      "label": "Temperature",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "mapsTo": {
        "target": "body",
        "path": "temperature"
      }
    },
    {
      "key": "top_p",
      "type": "number",
      "label": "Top P",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapsTo": {
        "target": "body",
        "path": "top_p"
      }
    },
    {
      "key": "max_tokens",
      "type": "integer",
      "label": "Max Tokens",
      "min": 1,
      "mapsTo": {
        "target": "body",
        "path": "max_tokens"
      },
      "default": 4096
    }
  ],
  "uiSchema": {
    "groups": [
      {
        "id": "credentials",
        "label": "Credentials",
        "order": 10
      },
      {
        "id": "generation",
        "label": "Generation",
        "order": 20
      }
    ],
    "fields": [
      {
        "key": "apiKey",
        "widget": "secret",
        "visibility": "basic",
        "group": "credentials",
        "order": 10
      },
      {
        "key": "modelId",
        "widget": "text",
        "visibility": "basic",
        "group": "generation",
        "order": 20
      },
      {
        "key": "temperature",
        "widget": "slider",
        "visibility": "advanced",
        "group": "generation",
        "order": 30
      },
      {
        "key": "top_p",
        "widget": "slider",
        "visibility": "advanced",
        "group": "generation",
        "order": 40
      },
      {
        "key": "max_tokens",
        "widget": "number-input",
        "visibility": "advanced",
        "group": "generation",
        "order": 50
      }
    ]
  },
  "capabilities": [
    "streaming",
    "vision",
    "tools",
    "json",
    "reasoning"
  ],
  "limits": {
    "known": false,
    "sourceUrls": [
      "https://direct.evolink.ai/v1/models"
    ]
  },
  "sourceUrls": [
    "https://direct.evolink.ai/v1/models"
  ]
}
